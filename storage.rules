rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Firmware binaries (legacy GeyserSwitch_Orange OTA) ──────────
    // Public read so an unauthenticated ESP32 can download updates.
    // Writes are DENIED to all clients: firmware is published only via
    // privileged tooling (Admin SDK / `firebase deploy` / CI), which
    // bypasses these rules. This closes the supply-chain hole where any
    // signed-in user could overwrite the binary that devices download.
    // (When gs_rework gains OTA, prefer authenticated read + signed
    // images over public read.)
    match /firmware/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Rework (gs_rework) firmware — token-gated, NOT public ───────
    // Separate path from the legacy public one above. Rule-based read is
    // DENIED; devices fetch the binary via a Firebase Storage download
    // token baked into the RTDB manifest URL (the manifest itself requires
    // auth to read), which bypasses this rule for legitimate devices while
    // an unauthenticated party can't enumerate or download the firmware.
    // Writes are publish-tooling only (Admin SDK / CI bypasses rules).
    match /firmware_gs/{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    // ── Telemetry data (gs_rework) ──────────────────────────────────
    // Each user can only read/write their own telemetry folder.
    match /telemetry/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // ── Deny everything else ────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
