{
  "rules": {

    "firmware": {
      ".read": "auth !== null"
    },

    "Orange": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },

    "GeyserSwitch": {
      "$uid": {
        ".read": "auth !== null && auth.uid === $uid",
        ".write": "auth !== null && auth.uid === $uid"
      }
    },

    "gs": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "live": {
          "$did": {
            ".validate": "newData.hasChildren(['t','on','at'])",
            "t":  { ".validate": "newData.isNumber()" },
            "on": { ".validate": "newData.isBoolean()" },
            "at": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        },

        "set": {
          "$did": {
            "on":    { ".validate": "newData.isBoolean()" },
            "max":   { ".validate": "newData.isNumber() && newData.val() >= 51 && newData.val() <= 65" },
            "min":   { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 50" },
            "ar":    { ".validate": "newData.isBoolean()" },
            "tmask": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 31" },
            "tcust": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1439" },
            "maxon": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
            "$other": { ".validate": false }
          }
        },

        "events": {
          "$did": {
            ".validate": "newData.hasChildren(['type','temp','at'])",
            "type":    { ".validate": "newData.isNumber()" },
            "temp":    { ".validate": "newData.isNumber()" },
            "at":      { ".validate": "newData.val() === now" },
            "$other":  { ".validate": false }
          }
        },

        "stats": {
          "$did": {
            "$date": {
              ".validate": "$date.matches(/^\\d{4}-\\d{2}-\\d{2}$/)",
              "rt": { ".validate": "newData.isNumber()" },
              "cy": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "meta": {
          "app":             { ".validate": "newData.val() === now" },
          "offlineNotified": {
            "$did": { ".validate": "newData.isBoolean()" }
          },
          "$did": {
            "boot":   { ".validate": "newData.isNumber()" },
            "health": {
              "rr":  { ".validate": "newData.isNumber()" },
              "fw":  { ".validate": "newData.isString() && newData.val().length < 16" },
              "at":  { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    ".read": false,
    ".write": false
  }
}
